+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = verify()
+
+    for groups in (
+        [group_slots([1, 2, 3, 6, 8], 5), group_slots([2, 4, 6, 7, 8], 2)],
