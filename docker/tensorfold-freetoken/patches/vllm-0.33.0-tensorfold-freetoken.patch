+@cache
+def _verification_counter() -> Counter:
+    return Counter(
+        "vllm:tensorfold_verification_total",
+        "Scheduled TensorFold verification steps, request rounds and draft rows.",
+        ("unit", "batch_size", "short_c8", "bucketed", "route"),
