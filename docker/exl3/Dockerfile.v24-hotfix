FROM vllm/vllm-openai:v0.32.0-dsv41-v23

COPY vllm/models/deepseek_v41/nvidia/model.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/model.py
COPY vllm/models/deepseek_v41/nvidia/dspark.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/dspark.py
COPY vllm/models/deepseek_v41/nvidia/ops/markov_cache.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/ops/markov_cache.py
COPY vllm/models/deepseek_v4/nvidia/ops/o_proj.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/nvidia/ops/o_proj.py
COPY vllm/models/deepseek_v41/attention.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/attention.py
COPY vllm/models/deepseek_v41/compressor.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/compressor.py
COPY vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py
COPY vllm/v1/attention/backends/mla/indexer.py /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/mla/indexer.py
COPY vllm/v1/worker/gpu/model_runner.py /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py
COPY vllm/v1/worker/gpu/spec_decode/depth_policy.py /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/depth_policy.py
COPY vllm/v1/worker/gpu/spec_decode/dspark/speculator.py /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dspark/speculator.py
COPY vllm/v1/worker/gpu/spec_decode/dspark/utils.py /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dspark/utils.py
