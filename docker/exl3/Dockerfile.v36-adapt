ARG VLLM_BASE_IMAGE=vllm/vllm-openai:v0.32.0-dsv41-v35
FROM ${VLLM_BASE_IMAGE}

ARG VLLM_SITE=/usr/local/lib/python3.12/dist-packages/vllm

COPY vllm/models/deepseek_v41/attention.py \
    ${VLLM_SITE}/models/deepseek_v41/attention.py
COPY vllm/models/deepseek_v41/common/engram.py \
    ${VLLM_SITE}/models/deepseek_v41/common/engram.py
COPY vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py \
    ${VLLM_SITE}/models/deepseek_v41/nvidia/flashinfer_sparse.py
COPY vllm/models/deepseek_v41/nvidia/model.py \
    ${VLLM_SITE}/models/deepseek_v41/nvidia/model.py
COPY vllm/utils/flashinfer.py ${VLLM_SITE}/utils/flashinfer.py
COPY vllm/v1/worker/gpu/cudagraph_utils.py \
    ${VLLM_SITE}/v1/worker/gpu/cudagraph_utils.py
COPY vllm/v1/worker/gpu/model_runner.py \
    ${VLLM_SITE}/v1/worker/gpu/model_runner.py
COPY vllm/v1/worker/gpu/short_ctx.py \
    ${VLLM_SITE}/v1/worker/gpu/short_ctx.py
COPY docker/exl3/run_tp2.sh /opt/vllm-exl3/run_tp2.sh

RUN chmod 0755 /opt/vllm-exl3/run_tp2.sh \
    && python3 -m py_compile \
        ${VLLM_SITE}/models/deepseek_v41/attention.py \
        ${VLLM_SITE}/models/deepseek_v41/common/engram.py \
        ${VLLM_SITE}/models/deepseek_v41/nvidia/flashinfer_sparse.py \
        ${VLLM_SITE}/models/deepseek_v41/nvidia/model.py \
        ${VLLM_SITE}/utils/flashinfer.py \
        ${VLLM_SITE}/v1/worker/gpu/cudagraph_utils.py \
        ${VLLM_SITE}/v1/worker/gpu/model_runner.py \
        ${VLLM_SITE}/v1/worker/gpu/short_ctx.py
