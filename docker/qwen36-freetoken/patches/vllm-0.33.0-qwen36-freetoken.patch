+        down = [
+            _get_cpu_bank(
+                layer.w2_weight,
+                (NUM_EXPERTS, HIDDEN_SIZE, INTERMEDIATE_SIZE),
+                f"{layer.layer_name}.w2_weight",
+            )
+            for layer in self.layers
+        ]
+        tp_info = try_get_tp_info()
